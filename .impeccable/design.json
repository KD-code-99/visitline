    {
      "name": "Continuous Visit Line",
      "kind": "custom",
      "description": "An illustrative four-part route showing the implemented matching, unknown, blocked and excluded treatments. These are sample states, not venue observations.",
      "html": "<ol class=\"ds-route-chain\" aria-label=\"Example parts of the visit\"><li class=\"ds-chain-stage ds-met\"><button type=\"button\" class=\"ds-stage-target\" aria-pressed=\"false\"><span class=\"ds-stage-stop\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"m4 10 4 4 8-8\"/></svg></span><span class=\"ds-stage-kind\">Arrival</span><span class=\"ds-stage-name\">Arrival point</span><span class=\"ds-stage-measurement\">90 cm of space</span><span class=\"ds-stage-status\">Details match</span></button></li><li class=\"ds-chain-stage ds-unknown\"><button type=\"button\" class=\"ds-stage-target\" aria-pressed=\"true\"><span class=\"ds-stage-stop\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M7 7a3 3 0 0 1 6 0c0 2-3 2-3 5m0 3h.01\"/></svg></span><span class=\"ds-stage-kind\">Entrance</span><span class=\"ds-stage-name\">Doorway</span><span class=\"ds-stage-measurement\">Space not measured</span><span class=\"ds-stage-status\">Needs checking</span></button></li><li class=\"ds-chain-stage ds-blocked\"><button type=\"button\" class=\"ds-stage-target\" aria-pressed=\"false\"><span class=\"ds-stage-stop\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"m5 5 10 10M15 5 5 15\"/></svg></span><span class=\"ds-stage-kind\">Seating</span><span class=\"ds-stage-name\">Seating space</span><span class=\"ds-stage-measurement\">80 cm of space</span><span class=\"ds-stage-status\">Does not match</span></button></li><li class=\"ds-chain-stage ds-excluded\"><button type=\"button\" class=\"ds-stage-target\" aria-pressed=\"false\"><span class=\"ds-stage-stop\"><svg viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M5 10h10\"/></svg></span><span class=\"ds-stage-kind\">Toilet</span><span class=\"ds-stage-name\">Way to a toilet</span><span class=\"ds-stage-measurement\">Space not measured</span><span class=\"ds-stage-status\">Not included</span></button></li></ol>",
      "css": ".ds-route-chain{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));margin:0;padding:0;gap:0;font-family:'Segoe UI',Arial,sans-serif;line-height:1.55;color:var(--ink,#193e36)}.ds-chain-stage{min-width:0;position:relative;padding:0 12px 0 0}.ds-chain-stage:not(:last-child)::after{content:'';position:absolute;height:2px;background:#9caf9e;top:19px;left:38px;right:0;z-index:0}.ds-stage-target{display:block;width:100%;min-height:155px;padding:0 9px 12px 0;border:0;border-radius:0;background:none;text-align:left;position:relative;font:inherit;font-weight:400;color:inherit;cursor:pointer}.ds-stage-target:hover{background:none}.ds-stage-target:focus-visible{outline:3px solid var(--focus,#235c9b);outline-offset:4px;}.ds-stage-stop{position:relative;z-index:1;display:flex;align-items:center;justify-content:center;width:40px;height:40px;border:2px solid var(--green,#22664f);color:var(--green,#22664f);background:var(--white,#fffefa);border-radius:50%}.ds-stage-stop svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}.ds-unknown .ds-stage-stop{border-color:var(--amber,#80501c);border-style:dashed;color:var(--amber,#80501c);background:var(--amber-tint,#fbefd8)}.ds-blocked .ds-stage-stop{border-color:var(--red,#923e35);color:var(--red,#923e35);background:var(--red-tint,#f8e9e2)}.ds-excluded{color:var(--muted,#52675f)}.ds-excluded .ds-stage-stop{border-color:#76877d;color:#76877d;background:var(--paper,#f7f5ee)}.ds-stage-target[aria-pressed=true] .ds-stage-stop{outline:3px solid var(--ink,#193e36);outline-offset:4px}.ds-stage-kind{display:block;font-size:.75rem;color:var(--muted,#52675f);margin-top:15px}.ds-stage-name{display:block;font-weight:600;font-size:.91rem;margin-top:3px}.ds-stage-measurement{display:block;font-size:.78rem;margin-top:7px;font-variant-numeric:tabular-nums}.ds-stage-status{display:block;font-size:.74rem;font-weight:600;margin-top:5px}.ds-unknown .ds-stage-status{color:var(--amber,#80501c)}.ds-blocked .ds-stage-status{color:var(--red,#923e35)}.ds-met .ds-stage-status{color:var(--green,#22664f)}@media(max-width:1000px){.ds-stage-name{font-size:.84rem}}@media(max-width:760px){.ds-chain-stage{padding-right:5px}.ds-chain-stage:not(:last-child)::after{left:36px}.ds-stage-stop{width:36px;height:36px}.ds-stage-target{padding-right:6px}.ds-stage-kind{font-size:.7rem}.ds-stage-name{font-size:.8rem;overflow-wrap:anywhere}.ds-stage-measurement{font-size:.72rem}.ds-stage-status{font-size:.7rem}}@media(max-width:520px){.ds-route-chain{grid-template-columns:1fr}.ds-chain-stage{padding:0 0 16px}.ds-chain-stage:not(:last-child)::after{top:36px;left:17px;right:auto;width:2px;height:calc(100% - 32px)}.ds-stage-target{min-height:88px;padding:0 0 8px 54px}.ds-stage-stop{position:absolute;left:0;top:0}.ds-stage-kind{margin:0}.ds-stage-name{font-size:.95rem}.ds-stage-measurement,.ds-stage-status{font-size:.8rem}}"
    }
  ],
  "narrative": {
    "northStar": "The Continuous Visit Line",
    "overview": "Visitline uses a continuous visit line as its organising image: arrival, entrance, seating and toilet remain connected so a reader can locate the part that matches, needs checking or causes a problem. Warm paper, dark green ink, restrained borders and modest corners keep the workspace calm while the route carries the most distinctive geometry.\n\nA self-hosted serif gives the name and major headings a human, editorial character; familiar system sans-serif text carries controls, measurements and explanations. The interface uses plain-English needs, parts and plan wording following the user's feedback that technical wording can be confusing. Density follows the authoring task: a compact needs column beside a broader route workspace, then a single column on smaller screens.",
    "keyCharacteristics": [
      "A connected route with explicit part-by-part results.",
      "Warm paper and near-white working surfaces with dark green ink.",
      "Self-hosted Newsreader headings paired with system sans-serif controls.",
      "State words reinforced by symbols, fill, border style and color.",
      "Flat surfaces, modest corners and visible keyboard-focus outlines."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Every result keeps a visible text label. Color and shape reinforce the label; neither replaces it.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use borders and surface color to separate the current workspace. The implemented system has no box shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the connected order of the visit parts when adapting the route diagram.",
      "Do show state words with the existing marker, symbol and border treatments.",
      "Do keep selected-route borders and selected-part outlines distinct from the blue keyboard-focus outline.",
      "Do use plain-English needs, parts and plan wording, with concrete action labels.",
      "Do keep observation forms and visitor-preview surfaces near-white against the paper canvas."
    ],
    "donts": [
      "Don't show a positive result for information that still needs checking.",
      "Don't rely on green, amber or red alone to explain a result.",
      "Don't add drop shadows to the current flat containers.",
      "Don't turn the modest corner values into pill-shaped controls.",
      "Don't treat this source-led documentation as evidence of design approval or an accessibility audit."
    ]
  }
}
